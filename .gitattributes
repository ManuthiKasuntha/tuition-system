# Force Linux (LF) line endings for files that run inside Linux / containers.
# Without this, a Windows checkout may convert them to CRLF and the shell
# scripts fail with errors like "/bin/bash^M: bad interpreter".
*.sh        text eol=lf
Jenkinsfile text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
.env.example text eol=lf
*.sql       text eol=lf
