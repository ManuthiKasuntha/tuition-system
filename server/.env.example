PORT=5000
CLIENT_URL=http://localhost:5173

# Local MySQL server (the database is created automatically if it does not exist)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Wrap the password in quotes if it contains # (otherwise everything after # is ignored)
DB_PASSWORD="your_mysql_password"
DB_NAME=tuition_system

# Use a long random string
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
