# TuitionHub - Docker Compose settings
# Copy this file to ".env" (in the same folder as compose.yaml) and change the values:
#     cp .env.example .env
# The real .env file is ignored by Git - never commit it.
#
# Use letters and numbers only for passwords (avoid $ # " ' and spaces).
# Generate random values with:   openssl rand -hex 24

# Port on YOUR computer where the website will be available: http://localhost:3000
# (Jenkins normally uses 8080, so we avoid that one.)
APP_PORT=3000

# MySQL administrator password (used only inside the mysql container)
MYSQL_ROOT_PASSWORD=change_me_root_password

# Database + application user that the backend connects with
DB_NAME=tuition_system
DB_USER=tuition_app
DB_PASSWORD=change_me_app_password

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
